# Tienda Angular 17 compilada como SPA estática (sin SSR) y servida por nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npx ng build --configuration production --ssr=false --prerender=false

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend-ecommerce/browser /usr/share/nginx/html
