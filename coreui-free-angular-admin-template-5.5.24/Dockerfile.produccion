# Admin CoreUI (Angular 20) servido bajo /admin/ por nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npx ng build --configuration production --base-href /admin/

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/coreui-free-angular-admin-template/browser /usr/share/nginx/html/admin
