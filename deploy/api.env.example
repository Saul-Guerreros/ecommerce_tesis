# Copiar a /opt/zinformatica/config/api.env  (chmod 600). NUNCA subir a Git.
APP_NAME="Z Informatica"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERAR_UNA_VEZ_Y_NO_CAMBIAR
APP_URL=https://zinformatica.columbiatcc.online

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=zinformatica
DB_USERNAME=zinformatica
DB_PASSWORD=MISMA_QUE_POSTGRES_PASSWORD

JWT_SECRET=GENERAR_UNA_VEZ_Y_NO_CAMBIAR

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Correo (verificación de cuenta y recuperación de contraseña)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="Z Informatica"

# Login con Google
GOOGLE_CLIENT_ID=920337025252-4o5j8pkgdufo263g2vgdijpm7vbq4e76.apps.googleusercontent.com

# IA (Gemini)
GEMINI_API_KEY=TU_CLAVE
